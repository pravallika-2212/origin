# ==============================================================================
# ORIGIN — Environment Configuration (Razorpay Payment Gateway)
# ==============================================================================
# NOTE: This file is a template with placeholders only.
# NEVER commit real production or test secrets to version control.
# Real credentials should be configured in Vercel Project Settings -> Environment Variables.

# Razorpay API Credentials (Obtain from Razorpay Dashboard -> Settings -> API Keys)
# In development/test mode, use keys starting with rzp_test_
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Razorpay Webhook Secret (Obtain when setting up Webhook in Razorpay Dashboard)
# Webhook URL: https://your-deployment-url.vercel.app/api/webhook
# Secret should be a strong random string entered in Razorpay Webhook settings
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Optional: Set to 'true' to run checkout in simulated offline demo mode without calling Razorpay API
# MOCK_PAYMENT=false
